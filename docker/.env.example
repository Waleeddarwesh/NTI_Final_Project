# .env.example
# Copy this to .env and fill in real values for local development.
# The .env file is in .gitignore — never commit it.
# In production (EKS), these come from Kubernetes Secrets / AWS Secrets Manager.

# ── Django core ───────────────────────────────────────────────────────────────
DJANGO_SETTINGS_MODULE=config.settings.development
# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=replace-with-output-of-get-random-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# ── Database ──────────────────────────────────────────────────────────────────
# For docker-compose: host is the service name "postgres"
# For EKS: host comes from the RDS endpoint secret in Secrets Manager
DATABASE_URL=postgres://appuser:apppassword@postgres:5432/appdb
DB_HOST=postgres
DB_PORT=5432

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
REDIS_HOST=redis
REDIS_PORT=6379

# ── AWS (only needed if using S3 media storage or Secrets Manager locally) ───
AWS_REGION=us-east-1
# Leave blank when running locally with docker-compose — boto3 will use
# instance metadata / IAM role when running on EC2/EKS.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── Sentry (optional) ─────────────────────────────────────────────────────────
SENTRY_DSN=
