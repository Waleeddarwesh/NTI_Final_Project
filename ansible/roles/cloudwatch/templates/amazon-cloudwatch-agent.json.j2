{
  "agent": {
    "metrics_collection_interval": 60,
    "run_as_user": "cwagent"
  },
  "logs": {
    "logs_collected": {
      "files": {
        "collect_list": [
          {
            "file_path": "/var/log/messages",
            "log_group_name": "/{{ project_name }}/{{ environment }}/jenkins/system",
            "log_stream_name": "{instance_id}/messages",
            "timestamp_format": "%b %d %H:%M:%S"
          },
          {
            "file_path": "/var/lib/jenkins/logs/tasks/*.log",
            "log_group_name": "/{{ project_name }}/{{ environment }}/jenkins/tasks",
            "log_stream_name": "{instance_id}/{hostname}",
            "timestamp_format": "%Y-%m-%d %H:%M:%S"
          },
          {
            "file_path": "/var/log/jenkins/jenkins.log",
            "log_group_name": "/{{ project_name }}/{{ environment }}/jenkins/app",
            "log_stream_name": "{instance_id}/jenkins",
            "timestamp_format": "%Y-%m-%d %H:%M:%S.%f"
          }
        ]
      }
    }
  },
  "metrics": {
    "namespace": "{{ project_name }}/{{ environment }}/Jenkins",
    "metrics_collected": {
      "cpu": {
        "measurement": ["cpu_usage_idle", "cpu_usage_user", "cpu_usage_system"],
        "metrics_collection_interval": 60,
        "totalcpu": true
      },
      "disk": {
        "measurement": ["used_percent", "inodes_free"],
        "metrics_collection_interval": 60,
        "resources": ["/", "/var/lib/jenkins"]
      },
      "mem": {
        "measurement": ["mem_used_percent", "mem_available"],
        "metrics_collection_interval": 60
      },
      "net": {
        "measurement": ["bytes_sent", "bytes_recv"],
        "metrics_collection_interval": 60,
        "resources": ["eth0"]
      }
    },
    "append_dimensions": {
      "InstanceId": "${aws:InstanceId}",
      "Project": "{{ project_name }}",
      "Environment": "{{ environment }}"
    }
  }
}
